# To use it, copy it to .env
# If for local development, you can leave default values
# If for production, do not use them. Use secrets instead

# The variables used by mysql docker image
MYSQL_DATABASE=resolveit_db
MYSQL_USER=user
MYSQL_PASSWORD=user
MYSQL_ROOT_PASSWORD=root

# The ports exposed to the host from docker
DB_PORT=3306
APP_PORT=8080